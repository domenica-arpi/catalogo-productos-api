                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"ok\",\n  \"message\": \"Inicio de sesión correcto\",\n  \"data\": {\n    \"token\": \"<jwt-omitido>\",\n    \"user\": {\n      \"id\": 2,\n      \"name\": \"Usuario Demo\",\n      \"email\": \"user@example.com\",\n      \"role\": \"user\",\n      \"createdAt\": \"2026-11-19T00:00:00.000Z\",\n      \"updatedAt\": \"2026-11-19T00:00:00.000Z\"\n    }\n  }\n}"
            }
