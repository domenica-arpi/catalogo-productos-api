      "name": "Favoritos",
      "item": [
        {
          "name": "Agregar favorito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Agregar favorito responde 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Favorito incluye datos del producto', function () {",
                  "  pm.expect(body).to.have.property('status', 'ok');",
                  "  pm.expect(body.data).to.have.property('favorite');",
                  "  pm.expect(body.data.favorite).to.have.property('productId');",
                  "  pm.expect(body.data.favorite).to.have.property('product');",
                  "  pm.expect(body.data.favorite.product).to.include.keys('name', 'description', 'category', 'price');",
                  "});",
                  "",
                  "if (body.data && body.data.favorite && body.data.favorite.productId) {",
                  "  pm.environment.set('favoriteProductId', String(body.data.favorite.productId));",
                  "}"
                ]
              }
            }
          ],
