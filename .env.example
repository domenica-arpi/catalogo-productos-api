# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catalogo_productos
DB_USER=postgres
DB_PASSWORD=tu_password

# JWT (autenticación)
# Usa un valor largo y aleatorio en entornos reales. Nunca subas el .env real.
JWT_SECRET=cambia_este_secreto_por_uno_seguro
JWT_EXPIRES_IN=1d
